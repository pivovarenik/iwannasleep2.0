<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="yourname">
        <createTable tableName="users">
            <column name="user_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="TEXT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="employees">
            <column name="employee_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_employee_user" references="users(user_id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="TEXT"/>
            <column name="hourly_rate" type="REAL"/>
            <column name="bank_account" type="TEXT"/>
        </createTable>

        <createTable tableName="reports">
            <column name="report_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_by" type="INT">
                <constraints nullable="false" foreignKeyName="fk_report_createdby" references="users(user_id)"/>
            </column>
            <column name="report_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="TEXT"/>
        </createTable>

        <createTable tableName="complaints">
            <column name="complaint_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_complaint_user" references="users(user_id)"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="response" type="TEXT"/>
            <column name="status" type="TEXT"/>
        </createTable>

        <createTable tableName="payrolls">
            <column name="payroll_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_payroll_employee" references="employees(employee_id)"/>
            </column>
            <column name="gross_salary" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="deductions" type="REAL"/>
            <column name="bonuses" type="REAL"/>
            <column name="net_salary" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="INT">
                <constraints foreignKeyName="fk_payroll_approvedby" references="users(user_id)"/>
            </column>
        </createTable>

        <createTable tableName="attendance">
            <column name="attendance_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_attendance_employee" references="employees(employee_id)"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="time_in" type="DATETIME"/>
            <column name="time_out" type="DATETIME"/>
            <column name="work_hours" type="REAL"/>
        </createTable>

        <createTable tableName="bonuses">
            <column name="bonus_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_bonus_employee" references="employees(employee_id)"/>
            </column>
            <column name="bonus_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="bonus_amount" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="TEXT"/>
        </createTable>

        <createTable tableName="deductions">
            <column name="deduction_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_deduction_employee" references="employees(employee_id)"/>
            </column>
            <column name="deduction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT"/>
            <column name="description" type="TEXT"/>
        </createTable>

    </changeSet>

</databaseChangeLog>